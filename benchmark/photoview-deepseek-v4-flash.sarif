          "properties": {
            "findingId": "AUTH-09",
            "status": "exploited",
            "authState": "Anonymous for the origin-validation bypass (upgrade accepted with attacker origin and no credentials); authenticated victim session required for the data-streaming variant.",
            "prerequisites": "For the authenticated data variant: the victim's auth-token cookie must ride the handshake (possible for same-site cross-origin contexts under SameSite=Lax, or via any cookie-bearing client); the unauthenticated socket acceptance itself has no prerequisites at all.",
            "sastRuleId": "CWE-942"
          },
