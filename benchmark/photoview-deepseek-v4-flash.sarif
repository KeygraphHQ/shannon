          ],
          "properties": {
            "findingId": "AUTHZ-01",
            "parameter": "albumId",
            "status": "exploited",
            "authState": "Any authenticated non-admin user who owns at least one album (the normal state of any PhotoView user — the admin grants users root albums by design). No victim interaction required.",
            "prerequisites": "An authenticated non-admin account that owns at least one album (the normal state of any PhotoView user — the admin grants users root albums by design). No victim interaction required.",
            "sastRuleId": "CWE-639"
          },
          "ruleIndex": 2
