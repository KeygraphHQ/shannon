# Shannon Environment Configuration
# Copy this file to .env and fill in your credentials. Enable exactly one provider.

# Shannon forwards your machine's /etc/hosts entries into the worker container. Set to false to disable.
# SHANNON_FORWARD_HOSTS=false

# =============================================================================
# OPTION 1: OpenAI (GPT-5.6 via the Responses API)
# =============================================================================
OPENAI_API_KEY=your-api-key-here

# Optional provider-specific model overrides. Defaults:
# OPENAI_SMALL_MODEL=gpt-5.6-luna
# OPENAI_MEDIUM_MODEL=gpt-5.6-terra
# OPENAI_LARGE_MODEL=gpt-5.6-sol

# =============================================================================
# OPTION 2: Direct Anthropic
# =============================================================================
# ANTHROPIC_API_KEY=your-api-key-here

# OR use an OAuth token instead
# CLAUDE_CODE_OAUTH_TOKEN=your-oauth-token-here

# Adaptive thinking is enabled automatically on Opus 4.6/4.7/4.8. Set to false to disable.
# CLAUDE_ADAPTIVE_THINKING=false

# Optional Anthropic-specific model overrides. Defaults:
# ANTHROPIC_SMALL_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_MEDIUM_MODEL=claude-sonnet-4-6
# ANTHROPIC_LARGE_MODEL=claude-opus-4-8

# =============================================================================
# OPTION 3: Custom Anthropic-Compatible Base URL
# =============================================================================
# ANTHROPIC_BASE_URL=https://your-proxy.example.com
# ANTHROPIC_AUTH_TOKEN=your-auth-token

# =============================================================================
# Provider-Neutral Model Overrides
# =============================================================================
# These apply when the active provider does not have its own tier override.
# TOML [models] settings resolve to these variables.
# SHANNON_SMALL_MODEL=...
# SHANNON_MEDIUM_MODEL=...
# SHANNON_LARGE_MODEL=...

# =============================================================================
# OPTION 4: AWS Bedrock
# =============================================================================
# https://aws.amazon.com/blogs/machine-learning/accelerate-ai-development-with-amazon-bedrock-api-keys/
# Bedrock requires all three model tiers through ANTHROPIC_*_MODEL or SHANNON_*_MODEL.
# Example model IDs for us-east-1:
# SHANNON_SMALL_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# SHANNON_MEDIUM_MODEL=us.anthropic.claude-sonnet-4-6
# SHANNON_LARGE_MODEL=us.anthropic.claude-opus-4-8
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=your-bearer-token
